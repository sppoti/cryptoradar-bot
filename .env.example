# Токен вашего бота от @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Ваш числовой ID в Telegram (узнать можно у бота @userinfobot)
ADMIN_ID=123456789

# Название вашего проекта / сервиса
PROJECT_NAME=CryptoRadar & VIP Insider

# Ссылка на закрытый канал или чат, которая выдается после оплаты (для обратной совместимости)
VIP_LINK=https://t.me/+your_private_channel_link

# ID закрытого VIP-канала для динамического управления доступом (например: -1001234567890)
# Если указан и отличается от CHANNEL_ID, бот генерирует одноразовые персональные ссылки,
# модерирует заявки (join requests) и автоматически исключает участников по истечении подписки.
VIP_CHANNEL_ID=

# ID закрытого VIP-канала для автопостинга сводок (например: -1001234567890 или @my_vip_channel)
# Оставьте пустым, если не планируете автопостинг в канал
CHANNEL_ID=

# Интервал автопостинга аналитики в канал (в часах, по умолчанию 4)
AUTOPILOT_INTERVAL_HOURS=4

# Реквизиты для оплаты по СБП / Карте (выводятся пользователю)
MANUAL_PAYMENT_DETAILS="💳 Оплата по СБП / Карте:\nБанк: Т-Банк / Сбер\nНомер карты: 2202208867846645\nНомер телефона (СБП): +79055356182\nПолучатель: Захар Воробей (Захар В.)"

# URL для Telegram Mini App (для запуска в продакшене укажите https:// адрес туннеля или домена)
WEBAPP_URL=http://127.0.0.1:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080
